+static int videotoolbox_start(AVCodecContext *avctx)
+{
+    const AVDOVIDecoderConfigurationRecord *cfg = videotoolbox_dovi_config(avctx);
+    int ret = videotoolbox_start_session(avctx, cfg);
+    if (ret < 0 && cfg) {
+        videotoolbox_stop(avctx);
+        av_log(avctx, AV_LOG_VERBOSE, "Retrying VideoToolbox with the compatible HEVC base layer.\n");
+        ret = videotoolbox_start_session(avctx, NULL);
+    }
+    return ret;
+}
