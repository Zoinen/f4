+/* VideoToolbox parses the compressed NAL units for per-picture HDR metadata
+ * only when the format description identifies the transfer function at session
+ * creation. Preserve the container's Dolby configuration for compatible base
+ * layers; the source transfer remains authoritative for the actual pixels. */
+static enum AVColorTransferCharacteristic videotoolbox_hevc_transfer(const AVCodecContext *avctx)
+{
+    const HEVCContext *h = avctx->priv_data;
+    if (h->sei.common.alternative_transfer.present)
+        return h->sei.common.alternative_transfer.preferred_transfer_characteristics;
+    return avctx->color_trc;
+}
+
+static bool videotoolbox_hevc_hdr(const AVCodecContext *avctx)
+{
+    const HEVCContext *h = avctx->priv_data;
+    enum AVColorTransferCharacteristic transfer;
+    if (avctx->codec_id != AV_CODEC_ID_HEVC || !h->pps || h->pps->sps->vps->vps_max_layers != 1)
+        return false;
+    transfer = videotoolbox_hevc_transfer(avctx);
+    return transfer == AVCOL_TRC_SMPTE2084 || transfer == AVCOL_TRC_ARIB_STD_B67;
+}
+
+static const AVDOVIDecoderConfigurationRecord *videotoolbox_dovi_config(const AVCodecContext *avctx)
+{
+    const HEVCContext *h = avctx->priv_data;
+    const AVDOVIDecoderConfigurationRecord *cfg;
+    enum AVColorTransferCharacteristic transfer;
+    if (!videotoolbox_hevc_hdr(avctx))
+        return NULL;
+    cfg = &h->dovi_ctx.cfg;
+    if (cfg->dv_profile != 8 || !cfg->rpu_present_flag || !cfg->bl_present_flag || cfg->el_present_flag)
+        return NULL;
+    transfer = videotoolbox_hevc_transfer(avctx);
+    if (cfg->dv_bl_signal_compatibility_id == 4 && transfer == AVCOL_TRC_ARIB_STD_B67)
+        return cfg;
+    if (cfg->dv_bl_signal_compatibility_id == 1 && transfer == AVCOL_TRC_SMPTE2084) {
+        if (__builtin_available(macOS 27.0, *))
+            return cfg;
+    }
+    return NULL;
+}
+
+static void videotoolbox_set_dvvc(CFMutableDictionaryRef atoms, const AVDOVIDecoderConfigurationRecord *cfg)
+{
+    /* Dolby Vision ISO Base Media File Format v2.3: DOVIDecoderConfigurationRecord. */
+    uint8_t bytes[24] = { cfg->dv_version_major, cfg->dv_version_minor };
+    CFDataRef data;
+    AV_WB16(bytes + 2, (cfg->dv_profile << 9) | (cfg->dv_level << 3) |
+                       (cfg->rpu_present_flag << 2) | (cfg->el_present_flag << 1) | cfg->bl_present_flag);
+    bytes[4] = (cfg->dv_bl_signal_compatibility_id << 4) | (cfg->dv_md_compression << 2);
+    data = CFDataCreate(NULL, bytes, sizeof(bytes));
+    if (data) {
+        CFDictionarySetValue(atoms, CFSTR("dvvC"), data);
+        CFRelease(data);
+    }
+}
+
+static void videotoolbox_set_ambient(CFMutableDictionaryRef extensions, const AVCodecContext *avctx)
+{
+    const HEVCContext *h = avctx->priv_data;
+    const H2645SEIAmbientViewingEnvironment *sei = &h->sei.common.ambient_viewing_environment;
+    const AVPacketSideData *sd = ff_get_coded_side_data(avctx, AV_PKT_DATA_AMBIENT_VIEWING_ENVIRONMENT);
+    uint8_t bytes[8];
+    CFDataRef data;
+    if (sei->present) {
+        AV_WB32(bytes, sei->ambient_illuminance);
+        AV_WB16(bytes + 4, sei->ambient_light_x);
+        AV_WB16(bytes + 6, sei->ambient_light_y);
+    } else if (sd && sd->size >= sizeof(AVAmbientViewingEnvironment)) {
+        const AVAmbientViewingEnvironment *env = (const AVAmbientViewingEnvironment *)sd->data;
+        int64_t lux, x, y;
+        if (env->ambient_illuminance.den <= 0 || env->ambient_light_x.den <= 0 || env->ambient_light_y.den <= 0)
+            return;
+        lux = av_rescale(env->ambient_illuminance.num, 10000, env->ambient_illuminance.den);
+        x = av_rescale(env->ambient_light_x.num, 50000, env->ambient_light_x.den);
+        y = av_rescale(env->ambient_light_y.num, 50000, env->ambient_light_y.den);
+        if (lux <= 0 || lux > UINT32_MAX || x < 0 || x > 50000 || y < 0 || y > 50000)
+            return;
+        AV_WB32(bytes, lux);
+        AV_WB16(bytes + 4, x);
+        AV_WB16(bytes + 6, y);
+    } else {
+        return;
+    }
+    data = CFDataCreate(NULL, bytes, sizeof(bytes));
+    if (data) {
+        CFDictionarySetValue(extensions, kCMFormatDescriptionExtension_AmbientViewingEnvironment, data);
+        CFRelease(data);
+    }
+}
+
+static void videotoolbox_set_hdr_colors(CFMutableDictionaryRef extensions, const AVCodecContext *avctx)
+{
+    CFStringRef transfer = av_map_videotoolbox_color_trc_from_av(videotoolbox_hevc_transfer(avctx));
+    CFStringRef primaries = av_map_videotoolbox_color_primaries_from_av(avctx->color_primaries);
+    CFStringRef matrix = av_map_videotoolbox_color_matrix_from_av(avctx->colorspace);
+    if (transfer)
+        CFDictionarySetValue(extensions, kCMFormatDescriptionExtension_TransferFunction, transfer);
+    if (primaries)
+        CFDictionarySetValue(extensions, kCMFormatDescriptionExtension_ColorPrimaries, primaries);
+    if (matrix)
+        CFDictionarySetValue(extensions, kCMFormatDescriptionExtension_YCbCrMatrix, matrix);
+    if (avctx->color_range == AVCOL_RANGE_JPEG)
+        CFDictionarySetValue(extensions, kCMFormatDescriptionExtension_FullRangeVideo, kCFBooleanTrue);
+    videotoolbox_set_ambient(extensions, avctx);
+}
