+#ifdef Q_OS_MACOS
+// Only the F4 video sink requests a preview. Keep its decoder surface alive
+// without advancing Qt's ordinary video, position, or audio notifications.
+class ScheduledVideoBuffer final : public QFFmpegVideoBuffer
+{
+public:
+    using QFFmpegVideoBuffer::QFFmpegVideoBuffer;
+    QVideoFrame upcoming;
+    qint64 hostTimeUs = 0;
+};
+
+bool isNativeHdr(const AVFrame *frame)
+{
+    return frame && frame->format == AV_PIX_FMT_VIDEOTOOLBOX && frame->data[3]
+            && (frame->color_trc == AVCOL_TRC_SMPTE2084 || frame->color_trc == AVCOL_TRC_ARIB_STD_B67);
+}
+#endif
+
+QVideoFrame makeVideoFrame(const Frame &frame, std::unique_ptr<QFFmpegVideoBuffer> buffer,
+                           const VideoTransformation &transform)
+{
+    QVideoFrameFormat format(buffer->size(), buffer->pixelFormat());
+    format.setColorSpace(buffer->colorSpace());
+    format.setColorTransfer(buffer->colorTransfer());
+    format.setColorRange(buffer->colorRange());
+    format.setMaxLuminance(buffer->maxNits());
+    format.setRotation(transform.rotation);
+    format.setMirrored(transform.mirroredHorizontallyAfterRotation);
+    QVideoFrame videoFrame = QVideoFramePrivate::createFrame(std::move(buffer), format);
+    videoFrame.setStartTime(frame.startTime().get());
+    videoFrame.setEndTime(frame.endTime().get());
+    return videoFrame;
+}
+} // namespace
+
+#ifdef Q_OS_MACOS
+extern "C" Q_DECL_EXPORT bool f4UpcomingVideoFrameV1(const QVideoFrame *current,
+                                                    QVideoFrame *upcoming, qint64 *hostTimeUs)
+{
+    auto *buffer = dynamic_cast<ScheduledVideoBuffer *>(QVideoFramePrivate::buffer(*current));
+    if (!buffer)
+        return false;
+    *upcoming = buffer->upcoming;
+    *hostTimeUs = buffer->hostTimeUs;
+    return true;
+}
+#endif
 
