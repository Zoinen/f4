+// Included inside QSGBatchRenderer for an isolated, opt-in experiment.
+struct F4VectorGate {
+    quint64 generation = 0, sequence = 0;
+    bool cpuComplete = false, present = false, ready = false, pending = false, failed = false;
+    int priority = 0;
+    QHash<Batch *, Element *> warmed;
+};
+static thread_local QHash<QSGNode *, QSharedPointer<F4VectorGate>> f4VectorGates;
+static thread_local quint64 f4VectorGateSequence = 0;
+
+static void f4ConfigureVectorGate(QSGNode *root, quint64 generation, bool complete,
+                                  bool present, int priority, bool prepared)
+{
+    auto &gate = f4VectorGates[root];
+    const bool changed = !gate || gate->generation != generation;
+    if (changed) {
+        gate = QSharedPointer<F4VectorGate>::create();
+        gate->generation = generation;
+        gate->sequence = ++f4VectorGateSequence;
+    }
+    gate->cpuComplete = complete;
+    gate->present = present;
+    gate->priority = priority;
+    gate->ready |= prepared;
+    if (changed && root->type() == QSGNode::TransformNodeType)
+        root->markDirty(QSGNode::DirtyForceUpdate);
+}
+
+static void f4RemoveVectorGate(QSGNode *root) { f4VectorGates.remove(root); }
+static bool f4VectorGateReady(QSGNode *root, quint64 generation)
+{
+    const auto gate = f4VectorGates.value(root);
+    return gate && gate->generation == generation && gate->ready;
+}
+
+static bool f4VectorGateNeedsFrame(QSGNode *root, quint64 generation)
+{
+    const auto gate = f4VectorGates.value(root);
+    return gate && gate->generation == generation && gate->pending && !gate->failed;
+}
+static bool f4VectorGateFailed(QSGNode *root, quint64 generation)
+{
+    const auto gate = f4VectorGates.value(root);
+    return gate && gate->generation == generation && gate->failed;
+}
+
+void *f4VectorUploadGateInterface()
+{
+    static F4VectorUploadGateInterface api{
+        2, sizeof(F4VectorUploadGateInterface), f4ConfigureVectorGate, f4RemoveVectorGate,
+        f4VectorGateReady, f4VectorGateNeedsFrame, f4VectorGateFailed};
+    return &api;
+}
+
+struct F4VectorGateFrame {
+    QHash<Batch *, QSharedPointer<F4VectorGate>> owners;
+    QHash<F4VectorGate *, QHash<Batch *, Element *>> current;
+    QList<QSharedPointer<F4VectorGate>> active;
+    QSet<Batch *> admitted;
+
+    F4VectorGateFrame(const QHash<QSGNode *, Node *> &nodes,
+                      const QDataBuffer<Batch *> &opaque, const QDataBuffer<Batch *> &alpha)
+    {
+        bool needsGate = false;
+        for (auto it = f4VectorGates.cbegin(); it != f4VectorGates.cend(); ++it) {
+            if ((!it.value()->ready || !it.value()->present) && nodes.contains(it.key())) {
+                active.append(it.value());
+                needsGate = true;
+            }
+        }
+        if (!needsGate) return;
+        for (const auto *batches : {&opaque, &alpha}) {
+            for (int i = 0; i < batches->size(); ++i) {
+                Batch *batch = batches->at(i);
+                if (!batch->first) continue;
+                QSharedPointer<F4VectorGate> gate;
+                QSGNode *firstNode = batch->isRenderNode
+                    ? static_cast<QSGNode *>(static_cast<RenderNodeElement *>(batch->first)->renderNode)
+                    : static_cast<QSGNode *>(batch->first->node);
+                for (QSGNode *node = firstNode; node; node = node->parent()) {
+                    auto found = f4VectorGates.constFind(node);
+                    if (found != f4VectorGates.cend()) { gate = found.value(); break; }
+                }
+                if (!gate || (gate->ready && gate->present)) continue;
+                owners.insert(batch, gate);
+                current[gate.data()].insert(batch, batch->first);
+                if (gate->warmed.value(batch) != batch->first
+                    || (!batch->isRenderNode && batch->needsUpload && !empty(batch)))
+                    gate->warmed.remove(batch);
+            }
+        }
+        for (const auto &gate : std::as_const(active)) {
+            const auto members = current.value(gate.data());
+            for (auto it = gate->warmed.begin(); it != gate->warmed.end();) {
+                if (members.value(it.key()) != it.value()) it = gate->warmed.erase(it);
+                else ++it;
+            }
+        }
+    }
+
+    static bool empty(Batch *batch)
+    {
+        if (batch->isRenderNode) return false;
+        for (Element *element = batch->first; element; element = element->nextInBatch)
+            if (element->node->geometry()->vertexCount()) return false;
+        return true;
+    }
+    static quint64 estimate(Batch *batch)
+    {
+        if (batch->isRenderNode || !batch->needsUpload) return 0;
+        quint64 result = 0;
+        for (Element *element = batch->first; element; element = element->nextInBatch) {
+            const auto *geometry = element->node->geometry();
+            result += quint64(geometry->vertexCount()) * (geometry->sizeOfVertex() + 4);
+            result += quint64(geometry->indexCount()) * geometry->sizeOfIndex();
+        }
+        return result;
+    }
+    F4VectorGate *owner(Batch *batch) const { return owners.value(batch).data(); }
+    bool shouldPrepare(Batch *batch) const
+    {
+        const auto *gate = owner(batch);
+        return !gate || (!gate->failed && ((gate->ready && gate->present) || admitted.contains(batch)));
+    }
+    bool recordPreparation(Batch *batch, bool ok)
+    {
+        auto *gate = owner(batch);
+        if (!gate) return true;
+        const bool buffersValid = batch->isRenderNode || empty(batch)
+            || (batch->vbo.buf && (!batch->ibo.size || batch->ibo.buf));
+        if ((!ok && !empty(batch)) || !buffersValid) gate->failed = true;
+        if (!gate->ready && !gate->failed && (ok || empty(batch)))
+            gate->warmed.insert(batch, batch->first);
+        return gate->ready && gate->present;
+    }
+    void finish()
+    {
+        for (const auto &gate : std::as_const(active)) {
+            gate->pending = !gate->ready && !gate->failed
+                && gate->warmed != current.value(gate.data());
+            if (!gate->ready && !gate->failed && gate->cpuComplete
+                && gate->warmed == current.value(gate.data()))
+                gate->ready = true;
+        }
+    }
+};
