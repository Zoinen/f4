+// Unmerged uploads contain raw geometry, not baked transforms or z orders.
+// A single permanently-unmergeable element can keep its own buffers when only
+// the drawing-order numbering changes. Ordinary dirty flags still win.
+static bool f4RetainSingleUnmergedBatch(const Batch *batch, bool depth)
+{
+    if (batch->merged || batch->needsUpload || batch->isRenderNode || !batch->first)
+        return false;
+    const Element *element = batch->first;
+    if (element->removed || element->nextInBatch || element->batch != batch
+        || element->root != batch->root)
+        return false;
+    const QSGGeometryNode *node = element->node;
+    const auto flags = node->activeMaterial()->flags();
+    if (node->geometry()->indexType() != QSGGeometry::UnsignedIntType
+        && !(flags & QSGMaterial::NoBatching))
+        return false;
+    const bool opaque = depth && node->inheritedOpacity() > OPAQUE_LIMIT
+        && !(flags & QSGMaterial::Blending);
+    return opaque == batch->isOpaque;
+}
