+            auto *parent = new QQuickItem(window.contentItem());
+            parent->setPosition(QPointF(16 + side*256, 16));
+            parent->setSize(QSizeF(240, 240));
+            parent->setClip(true);
+            parents.append(parent);
+            for (int i = 0; i < 128; ++i) {
+                auto *tile = new ColorTile(parent, side ? Qt::yellow : Qt::red);
