+void setEnabled(QQuickWindow *window, bool enabled)
+{
+    if (!window)
+        return;
+    window->setProperty(QQuickPixelGridPrivate::enabledProperty, enabled);
+    if (QQuickPixelGridPrivate::syncCache.window == window)
+        QQuickPixelGridPrivate::syncCache.enabled = enabled;
+    QQuickPixelGridPrivate::invalidateSubtree(window->contentItem());
+
+    if (!window->property("_f4.qtQuickPixelGrid.watchersInstalled").toBool()) {
+        window->setProperty("_f4.qtQuickPixelGrid.watchersInstalled", true);
+        QObject::connect(window, &QWindow::screenChanged, window,
+                         [window](QScreen *screen) {
+            if (auto previous = QQuickPixelGridPrivate::screenDpiConnections.take(window); previous)
+                QObject::disconnect(previous);
+            if (screen) {
+                auto connection = QObject::connect(
+                    screen, &QScreen::logicalDotsPerInchChanged, window,
+                    [window] {
+                        if (QtQuickPixelGrid::isEnabled(window))
+                            QQuickPixelGridPrivate::invalidateSubtree(window->contentItem());
+                    });
+                QQuickPixelGridPrivate::screenDpiConnections.insert(window, connection);
+            }
+            if (QtQuickPixelGrid::isEnabled(window))
+                QQuickPixelGridPrivate::invalidateSubtree(window->contentItem());
+        });
+        if (QScreen *screen = window->screen()) {
+            auto connection = QObject::connect(
+                screen, &QScreen::logicalDotsPerInchChanged, window,
+                [window] {
+                    if (QtQuickPixelGrid::isEnabled(window))
+                        QQuickPixelGridPrivate::invalidateSubtree(window->contentItem());
+                });
+            QQuickPixelGridPrivate::screenDpiConnections.insert(window, connection);
+        }
+        QObject::connect(window, &QObject::destroyed, [](QObject *object) {
+            QQuickPixelGridPrivate::screenDpiConnections.remove(
+                static_cast<QQuickWindow *>(object));
+        });
+    }
+}
+
+bool isEnabled(const QQuickWindow *window)
+{
+    return window && window->property(QQuickPixelGridPrivate::enabledProperty).toBool();
+}
+
+QRectF presentationBounds(const QQuickItem *item)
+{
+    if (!item)
+        return {};
+    QQuickWindow *window = item->window();
+    if (!window)
+        return item->boundingRect();
+    const QRectF local = QQuickPixelGridPrivate::snapRect(item, item->boundingRect());
+    const QPointF topLeft = const_cast<QQuickItem *>(item)->mapToItem(
+        window->contentItem(), local.topLeft());
+    return QRectF(topLeft, local.size());
+}
+
+QStringList unsupportedItems(const QQuickWindow *window)
+{
+    QStringList result;
+    if (!window)
+        return result;
+    std::function<void(QQuickItem *)> visit = [&](QQuickItem *item) {
+        if (!QQuickPixelGridPrivate::isSupported(item)) {
+            QString name = item->objectName();
+            if (name.isEmpty())
+                name = QString::fromLatin1(item->metaObject()->className());
+            if (!result.contains(name))
+                result.append(name);
+        }
+        for (QQuickItem *child : item->childItems())
+            visit(child);
+    };
+    visit(window->contentItem());
+    return result;
+}
+
