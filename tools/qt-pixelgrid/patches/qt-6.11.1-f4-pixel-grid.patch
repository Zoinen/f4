+QRectF snapRect(const QQuickItem *item, const QRectF &rect)
+{
+    if (!isEnabled(item))
+        return rect;
+    const qreal dpr = effectiveDpr(item);
+    const auto geometry = presentationGeometry(item, item->window(), dpr);
+    if (!geometry.supported)
+        return rect;
+    const QPointF origin = geometry.origin;
+    const qreal snappedX = geometry.snappedOrigin.x();
+    const qreal snappedY = geometry.snappedOrigin.y();
+    QQuickWindow *window = item->window();
+    const qreal left = physicalSnap(origin.x() + rect.left(), dpr, window) - snappedX;
+    const qreal right = physicalSnap(origin.x() + rect.right(), dpr, window) - snappedX;
+    const qreal top = physicalSnap(origin.y() + rect.top(), dpr, window) - snappedY;
+    const qreal bottom = physicalSnap(origin.y() + rect.bottom(), dpr, window) - snappedY;
+    return QRectF(QPointF(left, top), QPointF(right, bottom)).normalized();
