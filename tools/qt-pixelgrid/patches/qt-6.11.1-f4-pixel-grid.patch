+static qreal effectiveDpr(const QQuickItem *item)
+{
+    QQuickWindow *window = item ? item->window() : nullptr;
+    if (window && window == syncCache.window)
+        return syncCache.dpr;
+    return window ? window->effectiveDevicePixelRatio() : 1;
