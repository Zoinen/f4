+namespace QQuickPixelGridPrivate {
+
+static constexpr auto enabledProperty = "_f4.qtQuickPixelGrid.enabled";
+static constexpr qreal gridTolerance = 0.000001;
+static QHash<QQuickWindow *, QMetaObject::Connection> screenDpiConnections;
+
+struct PresentationGeometry
+{
+    QPointF origin;
+    QPointF snappedOrigin;
+    QPointF correction;
+    QPointF translation;
+    bool supported = true;
+};
