+struct SyncCache
+{
+    QQuickWindow *window = nullptr;
+    QQuickItem *root = nullptr;
+    qreal dpr = 1;
+    bool enabled = false;
+    bool pixelCenterEdges = false;
+    quint64 generation = 0;
+    QHash<const QQuickItem *, GeometryEntry> entries;
