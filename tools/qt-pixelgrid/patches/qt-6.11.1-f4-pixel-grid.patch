+static thread_local SyncCache syncCache;
+
+SyncScope::SyncScope(QQuickWindow *window)
+{
+    // Nested synchronization uses uncached geometry for another window.
+    if (syncCache.window)
+        return;
+    ownsScope = true;
+    syncCache.window = window;
+    syncCache.root = window->contentItem();
+    syncCache.dpr = window->effectiveDevicePixelRatio();
+    syncCache.enabled = window->property(enabledProperty).toBool();
+    syncCache.pixelCenterEdges = window->rendererInterface()->graphicsApi()
+        != QSGRendererInterface::Software;
+    ++syncCache.generation;
+}
+
+SyncScope::~SyncScope()
+{
+    if (!ownsScope)
+        return;
+    // Retain hash storage for the next frame, but never retain unused/deleted
+    // item entries indefinitely. Keys are compared only, never dereferenced.
+    syncCache.entries.removeIf([](QHash<const QQuickItem *, GeometryEntry>::iterator entry) {
+        return entry->generation != syncCache.generation;
+    });
+    syncCache.window = nullptr;
+    syncCache.root = nullptr;
+}
+
+static void invalidateSyncCache()
+{
+    // updatePaintNode implementations can dirty items during synchronization.
+    // Do not let an earlier lookup survive such a change, including reparenting.
+    if (syncCache.window)
+        ++syncCache.generation;
+}
+
+static qreal physicalSnap(qreal value, qreal dpr, QQuickWindow *window)
+{
+    if (dpr <= 0)
+        return value;
+    const bool pixelCenterEdges = window && (window == syncCache.window
+        ? syncCache.pixelCenterEdges
+        : window->rendererInterface()->graphicsApi() != QSGRendererInterface::Software);
+    if (pixelCenterEdges) {
+        // Match Qt's aliased GPU rectangle coverage at a pixel-center tie:
+        // a leading edge at N + 0.5 already covers pixel N (top/left rule).
+        // qRound would move that crisp edge forward and shrink the rectangle.
+        // Keep ties stable across equivalent floating-point ancestor sums.
+        return std::ceil(value * dpr - qreal(0.5) - gridTolerance) / dpr;
+    }
+    // Qt's software adaptation uses the QPainter rounding convention instead.
+    // Stabilize exact half-pixel sums in the same way as the hardware path.
+    const qreal physical = value * dpr;
+    return qreal(qRound64(physical + std::copysign(gridTolerance, physical))) / dpr;
+}
+
+static bool localGeometry(const QQuickItem *item, QPointF *translation)
+{
+    auto *priv = QQuickItemPrivate::get(const_cast<QQuickItem *>(item));
+    if (!qFuzzyIsNull(priv->rotation()) || !qFuzzyCompare(priv->scale(), qreal(1)))
+        return false;
+#if QT_CONFIG(quick_shadereffect)
+    if (priv->layer() && priv->layer()->enabled())
+        return false;
+#endif
+
+    // A QML/C++ QQuickItem subclass with its own scene-graph renderer is
+    // outside this prototype's primitive coverage. The regular Qt Quick
+    // leaves below are handled in their own updatePaintNode implementations.
+    if (item->flags().testFlag(QQuickItem::ItemHasContents)
+        && !item->inherits("QQuickRectangle")
+        && !item->inherits("QQuickBorderImage")
+        && !item->inherits("QQuickAnimatedImage")
+        && !item->inherits("QQuickImage")
+        && !item->inherits("QQuickText")
+        && !item->inherits("QQuickTextInput")
+        && !item->inherits("QQuickTextEdit")
+#if QT_CONFIG(quick_shadereffect)
+        && !isRectangularShaderEffect(item)
+#endif
+        ) {
+        return false;
+    }
+
+    const qreal x = priv->x.valueBypassingBindings();
+    const qreal y = priv->y.valueBypassingBindings();
+    if (priv->transforms.isEmpty()) {
+        *translation = QPointF(x, y);
+        return true;
+    }
+
+    QMatrix4x4 matrix;
+    if (x || y)
+        matrix.translate(x, y);
+    for (int index = priv->transforms.size() - 1; index >= 0; --index)
+        priv->transforms.at(index)->applyTo(&matrix);
+
+    const QTransform transform = matrix.toTransform();
+    if (!transform.isAffine())
+        return false;
+    const QPointF origin = transform.map(QPointF(0, 0));
+    *translation = origin;
+    const QPointF unitX = transform.map(QPointF(1, 0)) - origin;
+    const QPointF unitY = transform.map(QPointF(0, 1)) - origin;
+    return std::abs(unitX.x() - 1) <= gridTolerance
+        && std::abs(unitX.y()) <= gridTolerance
+        && std::abs(unitY.x()) <= gridTolerance
+        && std::abs(unitY.y() - 1) <= gridTolerance;
+}
+
+static PresentationGeometry presentationGeometry(const QQuickItem *item,
+                                                 QQuickWindow *window, qreal dpr)
+{
+    const bool cached = window && window == syncCache.window;
+    const QQuickItem *root = cached ? syncCache.root : (window ? window->contentItem() : nullptr);
+    if (!item || item == root)
+        return {};
+    if (cached) {
+        const auto found = syncCache.entries.constFind(item);
+        if (found != syncCache.entries.cend() && found->generation == syncCache.generation)
+            return found->geometry;
+    }
+
+    // Copy the parent result: inserting a child can rehash the table. No
+    // references into the hash may survive the recursive lookup or insertion.
+    const auto parent = presentationGeometry(item->parentItem(), window, dpr);
+    PresentationGeometry result;
+    QPointF translation;
+    result.supported = parent.supported && localGeometry(item, &translation);
+    if (result.supported) {
+        result.origin = parent.origin + translation;
+        result.snappedOrigin = QPointF(physicalSnap(result.origin.x(), dpr, window),
+                                       physicalSnap(result.origin.y(), dpr, window));
+        result.correction = (result.snappedOrigin - result.origin)
+            - (parent.snappedOrigin - parent.origin);
+        result.translation = result.snappedOrigin - parent.snappedOrigin;
+    }
+    if (cached)
+        syncCache.entries.insert(item, {result, syncCache.generation});
+    return result;
+}
